{{ 'purelane-ingredients.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Purelane ingredients — `purelane-homepage.html:1014-1105`.

  One glass panel, a centred head, and a row of botanicals. The five in the
  prototype are blocks so the row can grow or shrink; the grid is
  `repeat(5, 1fr)` above 760px exactly as the prototype has it, which is what
  the count is capped at.
{%- endcomment -%}

{%- assign anchor = section.settings.anchor | default: section.id | handleize -%}

<div class="pl pl-sec" id="{{ anchor }}" data-pl-scene="{{ section.settings.scene }}">
  <div class="pl-wrap">
    <div class="pl-glass pl-sec-pad pl-rv">
      {%- if section.settings.heading != blank -%}
        <div class="pl-head">
          {%- if section.settings.kicker != blank -%}
            <span class="pl-kicker">{{ section.settings.kicker }}</span>
          {%- endif -%}

          <h2 class="pl-d2">{{ section.settings.heading }}</h2>

          {%- if section.settings.show_rule -%}
            <div class="pl-rule">
              <i></i>
              {%- render 'purelane-icon', icon: 'leaf' -%}
              <i></i>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="pl-ing">
          {%- for block in section.blocks -%}
            <div class="pl-ing__item" {{ block.shopify_attributes }}>
              <div class="pl-ing__art">
                {%- render 'purelane-ingredient-art', art: block.settings.art -%}
              </div>
              {%- if block.settings.name != blank -%}
                <h3 class="pl-ing__name">{{ block.settings.name }}</h3>
              {%- endif -%}
              {%- if block.settings.note != blank -%}
                <p class="pl-ing__note">{{ block.settings.note }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.purelane_ingredients.name",
  "tag": "section",
  "class": "pl-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.purelane_shared.settings.kicker.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.purelane_shared.settings.heading.label",
      "default": "Sourced from nature"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "t:sections.purelane_shared.settings.show_rule.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.purelane_shared.settings.anchor_header.content"
    },
    {
      "type": "range",
      "id": "scene",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2,
      "label": "t:sections.purelane_shared.settings.scene.label",
      "info": "t:sections.purelane_shared.settings.scene.info"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "t:sections.purelane_shared.settings.anchor.label",
      "default": "ingredients",
      "info": "t:sections.purelane_shared.settings.anchor.info"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "t:sections.purelane_ingredients.blocks.ingredient.name",
      "settings": [
        {
          "type": "select",
          "id": "art",
          "label": "t:sections.purelane_ingredients.blocks.ingredient.settings.art.label",
          "options": [
            { "value": "coconut", "label": "t:sections.purelane_ingredients.blocks.ingredient.settings.art.options__coconut.label" },
            { "value": "orange-peel", "label": "t:sections.purelane_ingredients.blocks.ingredient.settings.art.options__orange.label" },
            { "value": "soap-nut", "label": "t:sections.purelane_ingredients.blocks.ingredient.settings.art.options__soap_nut.label" },
            { "value": "neem", "label": "t:sections.purelane_ingredients.blocks.ingredient.settings.art.options__neem.label" },
            { "value": "lemongrass", "label": "t:sections.purelane_ingredients.blocks.ingredient.settings.art.options__lemongrass.label" }
          ],
          "default": "coconut"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.purelane_ingredients.blocks.ingredient.settings.name.label",
          "default": "Coconut"
        },
        {
          "type": "text",
          "id": "note",
          "label": "t:sections.purelane_ingredients.blocks.ingredient.settings.note.label",
          "default": "Plant-derived cleansers that lift grease"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.purelane_ingredients.presets.name",
      "blocks": [
        { "type": "ingredient", "settings": { "art": "coconut", "name": "Coconut", "note": "Plant-derived cleansers that lift grease" } },
        { "type": "ingredient", "settings": { "art": "orange-peel", "name": "Orange peel", "note": "Natural degreaser and fresh citrus lift" } },
        { "type": "ingredient", "settings": { "art": "soap-nut", "name": "Soap nut", "note": "A traditional plant foaming agent" } },
        { "type": "ingredient", "settings": { "art": "neem", "name": "Neem", "note": "Time-tested antibacterial from the tree" } },
        { "type": "ingredient", "settings": { "art": "lemongrass", "name": "Lemongrass", "note": "Clean fragrance with nothing synthetic" } }
      ]
    }
  ]
}
{% endschema %}
