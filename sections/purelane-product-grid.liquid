{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-card.css' | asset_url | stylesheet_tag }}
{{ 'purelane-product-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign anchor = section.settings.anchor | default: section.id | handleize

  case section.settings.source
    when 'collection'
      assign products = section.settings.collection.products
      assign limit = section.settings.products_to_show
    else
      assign products = null
  endcase
-%}

<div class="pl pl-sec" id="{{ anchor }}">
  <div class="pl-wrap">
    {%- if section.settings.kicker != blank or section.settings.heading != blank -%}
      <div class="pl-head pl-rv">
        {%- if section.settings.kicker != blank -%}
          <span class="pl-kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="pl-d2">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.show_rule -%}
          <div class="pl-rule">
            <i></i>
            {%- render 'purelane-icon', icon: 'leaf' -%}
            <i></i>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="pl-shelf">
      {%- if section.settings.source == 'collection' -%}
        {%- for product in products limit: limit -%}
          {%- assign delay = forloop.index0 | modulo: 4 -%}
          {%- render 'purelane-product-card',
            product: product,
            reveal_delay: delay,
            form_id: 'pl-grid-form-' | append: section.id | append: '-' | append: forloop.index,
            loading: 'lazy'
          -%}
        {%- else -%}
          {%- comment -%}
            No collection picked yet, or the collection is empty. Dawn's
            onboarding placeholders keep the section legible in the editor
            instead of collapsing to nothing.
          {%- endcomment -%}
          {%- for i in (1..4) -%}
            {%- render 'purelane-product-card-placeholder', index: i -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- assign delay = forloop.index0 | modulo: 4 -%}
          {%- if block.settings.product != blank -%}
            {%- render 'purelane-product-card',
              product: block.settings.product,
              badge: block.settings.badge,
              reveal_delay: delay,
              form_id: 'pl-grid-form-' | append: section.id | append: '-' | append: block.id,
              loading: 'lazy',
              block: block
            -%}
          {%- else -%}
            {%- render 'purelane-product-card-placeholder', index: forloop.index, block: block -%}
          {%- endif -%}
        {%- else -%}
          {%- for i in (1..4) -%}
            {%- render 'purelane-product-card-placeholder', index: i -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.purelane_product_grid.name",
  "tag": "section",
  "class": "pl-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.purelane_shared.settings.kicker.label",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.purelane_shared.settings.heading.label",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "t:sections.purelane_shared.settings.show_rule.label",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.purelane_product_grid.settings.products_header.content"
    },
    {
      "type": "select",
      "id": "source",
      "label": "t:sections.purelane_product_grid.settings.source.label",
      "options": [
        {
          "value": "collection",
          "label": "t:sections.purelane_product_grid.settings.source.options__collection.label"
        },
        {
          "value": "blocks",
          "label": "t:sections.purelane_product_grid.settings.source.options__blocks.label"
        }
      ],
      "default": "collection",
      "info": "t:sections.purelane_product_grid.settings.source.info"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:sections.purelane_product_grid.settings.collection.label"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8,
      "label": "t:sections.purelane_product_grid.settings.products_to_show.label"
    },
    {
      "type": "header",
      "content": "t:sections.purelane_shared.settings.anchor_header.content"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "t:sections.purelane_shared.settings.anchor.label",
      "default": "shop",
      "info": "t:sections.purelane_shared.settings.anchor.info"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "t:sections.purelane_product_grid.blocks.product.name",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "t:sections.purelane_product_grid.blocks.product.settings.product.label"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "t:sections.purelane_product_grid.blocks.product.settings.badge.label",
          "info": "t:sections.purelane_product_grid.blocks.product.settings.badge.info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.purelane_product_grid.presets.name"
    }
  ]
}
{% endschema %}
