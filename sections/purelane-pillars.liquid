{{ 'purelane-pillars.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Purelane pillars — `purelane-homepage.html:1106-1134`, the "how it works"
  row of three glass cards.

  The prototype's three cards each end in a "Learn more" ghost button pointing
  at another section on the page, so the link is a per-block setting rather
  than a section-wide one.
{%- endcomment -%}

{%- assign anchor = section.settings.anchor | default: section.id | handleize -%}

<div class="pl pl-sec" id="{{ anchor }}" data-pl-scene="{{ section.settings.scene }}">
  <div class="pl-wrap">
    {%- if section.settings.kicker != blank or section.settings.heading != blank -%}
      <div class="pl-head pl-rv">
        {%- if section.settings.kicker != blank -%}
          <span class="pl-kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="pl-d2">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="pl-pillars">
        {%- for block in section.blocks -%}
          {%- comment -%}
            The prototype's reveal delays on this row are 0, 2, 3 — not 0, 1, 2.
          {%- endcomment -%}
          {%- assign delay = forloop.index0 -%}
          {%- if delay > 0 -%}
            {%- assign delay = delay | plus: 1 -%}
          {%- endif -%}

          <article
            class="pl-glass pl-pillar pl-rv{% if delay > 0 %} pl-rv-d{{ delay }}{% endif %}"
            {{ block.shopify_attributes }}
          >
            <span class="pl-pillar__icon">
              {%- render 'purelane-icon', icon: block.settings.icon -%}
            </span>

            {%- if block.settings.heading != blank -%}
              <h3 class="pl-d3">{{ block.settings.heading }}</h3>
            {%- endif -%}

            {%- if block.settings.body != blank -%}
              <p class="pl-body-s">{{ block.settings.body }}</p>
            {%- endif -%}

            {%- if block.settings.cta_label != blank -%}
              <a class="pl-btn pl-btn--ghost pl-btn--sm" href="{{ block.settings.cta_link | default: '#' }}">
                {{ block.settings.cta_label }}
              </a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.purelane_pillars.name",
  "tag": "section",
  "class": "pl-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.purelane_shared.settings.kicker.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.purelane_shared.settings.heading.label",
      "info": "t:sections.purelane_pillars.settings.heading.info"
    },
    {
      "type": "header",
      "content": "t:sections.purelane_shared.settings.anchor_header.content"
    },
    {
      "type": "range",
      "id": "scene",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2,
      "label": "t:sections.purelane_shared.settings.scene.label",
      "info": "t:sections.purelane_shared.settings.scene.info"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "t:sections.purelane_shared.settings.anchor.label",
      "default": "how",
      "info": "t:sections.purelane_shared.settings.anchor.info"
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "t:sections.purelane_pillars.blocks.pillar.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.purelane_shared.settings.icon.label",
          "options": [
            { "value": "bubbles", "label": "t:sections.purelane_pillars.blocks.pillar.settings.icon.options__bubbles.label" },
            { "value": "shield", "label": "t:sections.purelane_shared.settings.icon.options__shield.label" },
            { "value": "heart", "label": "t:sections.purelane_pillars.blocks.pillar.settings.icon.options__heart.label" },
            { "value": "leaf", "label": "t:sections.purelane_shared.settings.icon.options__leaf.label" },
            { "value": "check", "label": "t:sections.purelane_shared.settings.icon.options__check.label" }
          ],
          "default": "bubbles"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.purelane_shared.settings.heading.label",
          "default": "Less scrubbing"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "t:sections.purelane_pillars.blocks.pillar.settings.body.label"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "t:sections.purelane_pillars.blocks.pillar.settings.cta_label.label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "t:sections.purelane_combos.settings.cta_link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.purelane_pillars.presets.name",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "icon": "bubbles",
            "heading": "Less scrubbing",
            "body": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "shield",
            "heading": "Clean ingredients",
            "body": "No sulphates, no chlorine, no synthetic fragrance. Nothing on the label you would not want near your food."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "icon": "heart",
            "heading": "Safe around everyone",
            "body": "Gentle on hands, safe around kids and pets, and it leaves no toxic residue on the surfaces you touch every day."
          }
        }
      ]
    }
  ]
}
{% endschema %}
