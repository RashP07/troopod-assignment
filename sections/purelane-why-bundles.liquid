{{ 'purelane-why-bundles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Purelane "why bundles beat buying single" — `purelane-homepage.html:1453-1464`.
  A glass panel, centred head, four reasons.
{%- endcomment -%}

{%- assign anchor = section.settings.anchor | default: section.id | handleize -%}

<div class="pl pl-sec" id="{{ anchor }}" data-pl-scene="{{ section.settings.scene }}">
  <div class="pl-wrap">
    <div class="pl-glass pl-sec-pad pl-rv">
      {%- if section.settings.kicker != blank or section.settings.heading != blank -%}
        <div class="pl-head">
          {%- if section.settings.kicker != blank -%}
            <span class="pl-kicker">{{ section.settings.kicker }}</span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="pl-d2">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="pl-wb">
          {%- for block in section.blocks -%}
            <div class="pl-wb__item" {{ block.shopify_attributes }}>
              <span class="pl-wb__icon">
                {%- render 'purelane-icon', icon: block.settings.icon -%}
              </span>
              {%- if block.settings.heading != blank -%}
                <h3 class="pl-wb__title">{{ block.settings.heading }}</h3>
              {%- endif -%}
              {%- if block.settings.note != blank -%}
                <p class="pl-wb__note">{{ block.settings.note }}</p>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.purelane_why_bundles.name",
  "tag": "section",
  "class": "pl-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.purelane_shared.settings.kicker.label",
      "default": "The smarter way to shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.purelane_shared.settings.heading.label",
      "default": "Why bundles beat buying single"
    },
    {
      "type": "header",
      "content": "t:sections.purelane_shared.settings.anchor_header.content"
    },
    {
      "type": "range",
      "id": "scene",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "t:sections.purelane_shared.settings.scene.label",
      "info": "t:sections.purelane_shared.settings.scene.info"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "t:sections.purelane_shared.settings.anchor.label",
      "default": "whybundles",
      "info": "t:sections.purelane_shared.settings.anchor.info"
    }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "t:sections.purelane_why_bundles.blocks.reason.name",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:sections.purelane_shared.settings.icon.label",
          "options": [
            { "value": "rupee", "label": "t:sections.purelane_why_bundles.blocks.reason.settings.icon.options__rupee.label" },
            { "value": "check-square", "label": "t:sections.purelane_why_bundles.blocks.reason.settings.icon.options__check_square.label" },
            { "value": "star-outline", "label": "t:sections.purelane_why_bundles.blocks.reason.settings.icon.options__star.label" },
            { "value": "truck", "label": "t:sections.purelane_why_bundles.blocks.reason.settings.icon.options__truck.label" },
            { "value": "leaf", "label": "t:sections.purelane_shared.settings.icon.options__leaf.label" },
            { "value": "shield", "label": "t:sections.purelane_shared.settings.icon.options__shield.label" }
          ],
          "default": "rupee"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.purelane_shared.settings.heading.label",
          "default": "Save up to 45%"
        },
        {
          "type": "text",
          "id": "note",
          "label": "t:sections.purelane_why_bundles.blocks.reason.settings.note.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.purelane_why_bundles.presets.name",
      "blocks": [
        { "type": "reason", "settings": { "icon": "rupee", "heading": "Save up to 45%", "note": "Versus buying the same products separately" } },
        { "type": "reason", "settings": { "icon": "check-square", "heading": "One flat price", "note": "No calculators, no comparing carts" } },
        { "type": "reason", "settings": { "icon": "star-outline", "heading": "Curated by experts", "note": "Products picked to work well together" } },
        { "type": "reason", "settings": { "icon": "truck", "heading": "Free shipping always", "note": "Included on every bundle, all India" } }
      ]
    }
  ]
}
{% endschema %}
