{{ 'purelane-base.css' | asset_url | stylesheet_tag }}
{{ 'purelane-card.css' | asset_url | stylesheet_tag }}
{{ 'purelane-combos.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign anchor = section.settings.anchor | default: section.id | handleize
  # A metaobject_list setting hands back the entries directly; `.value` is the
  # shape a metafield would have. Accept either so the section is not at the
  # mercy of which one this Shopify version returns.
  assign combos = section.settings.combos
  if combos.value
    assign combos = combos.value
  endif
  assign use_metaobjects = false
  if section.settings.source == 'metaobject' and combos.size > 0
    assign use_metaobjects = true
  endif
-%}

<div class="pl pl-sec" id="{{ anchor }}" data-pl-scene="{{ section.settings.scene }}">
  <div class="pl-wrap">
    {%- if section.settings.kicker != blank or section.settings.heading != blank or section.settings.lede != blank -%}
      <div class="pl-head pl-rv">
        {%- if section.settings.kicker != blank -%}
          <span class="pl-kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="pl-d2">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.show_rule -%}
          <div class="pl-rule">
            <i></i>
            {%- render 'purelane-icon', icon: 'leaf' -%}
            <i></i>
          </div>
        {%- endif -%}

        {%- if section.settings.lede != blank -%}
          <p class="pl-lede">{{ section.settings.lede }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      A scroll-snap rail rather than a JS carousel: it is keyboard scrollable
      and touch-native for free, and costs no JavaScript at all.
    {%- endcomment -%}
    <div
      class="pl-rail pl-comborail pl-rv"
      role="region"
      aria-label="{{ section.settings.heading | default: 'Combos' | escape }}"
      tabindex="0"
    >
      {%- if use_metaobjects -%}
        {%- for combo in combos -%}
          {%- assign delay = forloop.index0 | modulo: 4 -%}
          {%- render 'purelane-combo-card',
            combo: combo,
            cta_label: section.settings.cta_label,
            cta_link: section.settings.cta_link,
            reveal_delay: delay
          -%}
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          {%- assign delay = forloop.index0 | modulo: 4 -%}
          {%- render 'purelane-combo-card',
            block: block,
            cta_label: section.settings.cta_label,
            cta_link: section.settings.cta_link,
            reveal_delay: delay
          -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.swipe_cue != blank -%}
      <div class="pl-swipecue" aria-hidden="true">
        {%- render 'purelane-icon', icon: 'arrow' -%}
        {{ section.settings.swipe_cue }}
      </div>
    {%- endif -%}

    {%- if section.settings.rail_note != blank -%}
      <p class="pl-rail-note">{{ section.settings.rail_note }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.purelane_combos.name",
  "tag": "section",
  "class": "pl-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.purelane_shared.settings.kicker.label",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.purelane_shared.settings.heading.label",
      "default": "Best selling combos"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "t:sections.purelane_shared.settings.show_rule.label",
      "default": true
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "t:sections.purelane_hero.settings.lede.label",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    },
    {
      "type": "header",
      "content": "t:sections.purelane_combos.settings.combos_header.content"
    },
    {
      "type": "select",
      "id": "source",
      "label": "t:sections.purelane_product_grid.settings.source.label",
      "options": [
        {
          "value": "metaobject",
          "label": "t:sections.purelane_combos.settings.source.options__metaobject.label"
        },
        {
          "value": "blocks",
          "label": "t:sections.purelane_reviews.settings.source.options__blocks.label"
        }
      ],
      "default": "metaobject",
      "info": "t:sections.purelane_combos.settings.source.info"
    },
    {
      "type": "metaobject_list",
      "id": "combos",
      "metaobject_type": "combo",
      "limit": 12,
      "label": "t:sections.purelane_combos.settings.combos.label"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.purelane_combos.settings.cta_label.label",
      "default": "Shop bundle"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "t:sections.purelane_combos.settings.cta_link.label",
      "info": "t:sections.purelane_combos.settings.cta_link.info"
    },
    {
      "type": "header",
      "content": "t:sections.purelane_combos.settings.rail_header.content"
    },
    {
      "type": "text",
      "id": "swipe_cue",
      "label": "t:sections.purelane_combos.settings.swipe_cue.label",
      "default": "Swipe for more combos"
    },
    {
      "type": "textarea",
      "id": "rail_note",
      "label": "t:sections.purelane_combos.settings.rail_note.label",
      "default": "Tapping \"Shop bundle\" opens the bundle picker with these products already added. You can still swap anything before you pay."
    },
    {
      "type": "header",
      "content": "t:sections.purelane_shared.settings.anchor_header.content"
    },
    {
      "type": "range",
      "id": "scene",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.purelane_shared.settings.scene.label",
      "info": "t:sections.purelane_shared.settings.scene.info"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "t:sections.purelane_shared.settings.anchor.label",
      "default": "combos",
      "info": "t:sections.purelane_shared.settings.anchor.info"
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "t:sections.purelane_combos.blocks.combo.name",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.purelane_combos.blocks.combo.settings.title.label"
        },
        {
          "type": "product_list",
          "id": "products",
          "limit": 8,
          "label": "t:sections.purelane_combos.blocks.combo.settings.products.label",
          "info": "t:sections.purelane_combos.blocks.combo.settings.products.info"
        },
        {
          "type": "range",
          "id": "thumbnails",
          "min": 2,
          "max": 5,
          "step": 1,
          "default": 3,
          "label": "t:sections.purelane_combos.blocks.combo.settings.thumbnails.label"
        },
        {
          "type": "product",
          "id": "bundle",
          "label": "t:sections.purelane_combos.blocks.combo.settings.bundle.label",
          "info": "t:sections.purelane_combos.blocks.combo.settings.bundle.info"
        },
        {
          "type": "text",
          "id": "flag",
          "label": "t:sections.purelane_combos.blocks.combo.settings.flag.label"
        },
        {
          "type": "text",
          "id": "save_label",
          "label": "t:sections.purelane_combos.blocks.combo.settings.save_label.label",
          "info": "t:sections.purelane_combos.blocks.combo.settings.save_label.info"
        },
        {
          "type": "textarea",
          "id": "includes",
          "label": "t:sections.purelane_combos.blocks.combo.settings.includes.label"
        },
        {
          "type": "text",
          "id": "fine_print",
          "label": "t:sections.purelane_combos.blocks.combo.settings.fine_print.label",
          "default": "Inclusive of all taxes · COD available"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "t:sections.purelane_combos.blocks.combo.settings.featured.label",
          "default": false
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "t:sections.purelane_combos.settings.cta_link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.purelane_combos.presets.name",
      "settings": {
        "source": "blocks"
      },
      "blocks": [
        { "type": "combo", "settings": { "title": "Kitchen essentials", "flag": "Most popular" } },
        { "type": "combo", "settings": { "title": "Laundry care bundle" } },
        { "type": "combo", "settings": { "title": "Complete home bundle", "flag": "Best value", "featured": true } },
        { "type": "combo", "settings": { "title": "Bathroom deep clean" } },
        { "type": "combo", "settings": { "title": "Hard water solution kit", "thumbnails": 2 } }
      ]
    }
  ]
}
{% endschema %}
