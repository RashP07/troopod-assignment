{{ 'purelane-signup.css' | asset_url | stylesheet_tag }}
<script src="{{ 'purelane-reveal.js' | asset_url }}" defer="defer"></script>

{%- comment -%}
  Purelane signup band — `purelane-homepage.html:1505-1517`.

  The prototype's form is `onsubmit="return false"` with an input that goes
  nowhere. This is Shopify's customer form, tagged `newsletter` the way Dawn
  tags its own, so a submission actually creates a subscriber and the success
  and error states have somewhere to come from.
{%- endcomment -%}

{%- assign anchor = section.settings.anchor | default: section.id | handleize -%}

<div class="pl pl-sec" id="{{ anchor }}" data-pl-scene="{{ section.settings.scene }}">
  <div class="pl-wrap">
    <div class="pl-glass pl-signup pl-rv">
      {%- if section.settings.kicker != blank -%}
        <span class="pl-kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="pl-d2">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.lede != blank -%}
        <p class="pl-lede">{{ section.settings.lede }}</p>
      {%- endif -%}

      {%- form 'customer', class: 'pl-signup__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="pl-visually-hidden" for="pl-signup-{{ section.id }}">
          {{- 'newsletter.label' | t -}}
        </label>
        <input
          class="pl-signup__field"
          id="pl-signup-{{ section.id }}"
          type="email"
          name="contact[email]"
          value="{{ form.email }}"
          autocomplete="email"
          placeholder="{{ section.settings.placeholder | escape }}"
          required
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="pl-signup-error-{{ section.id }}"
          {% endif %}
        >
        <button class="pl-btn pl-btn--primary" type="submit">
          {{ section.settings.cta_label | default: 'Subscribe' }}
        </button>

        {%- if form.errors -%}
          <p class="pl-signup__msg pl-signup__msg--error" id="pl-signup-error-{{ section.id }}">
            {{ form.errors.translated_fields.email | capitalize }}
            {{ form.errors.messages.email }}
          </p>
        {%- elsif form.posted_successfully? -%}
          <p class="pl-signup__msg" role="status">{{ 'newsletter.success' | t }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.purelane_signup.name",
  "tag": "section",
  "class": "pl-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.purelane_shared.settings.kicker.label",
      "default": "Join the Purelane Club"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.purelane_shared.settings.heading.label",
      "default": "Get ₹100 off your first bundle"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "t:sections.purelane_hero.settings.lede.label",
      "default": "Plus first access to new launches and restocks."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "t:sections.purelane_signup.settings.placeholder.label",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "t:sections.purelane_combos.settings.cta_label.label",
      "default": "Get my ₹100 off"
    },
    {
      "type": "header",
      "content": "t:sections.purelane_shared.settings.anchor_header.content"
    },
    {
      "type": "range",
      "id": "scene",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 4,
      "label": "t:sections.purelane_shared.settings.scene.label",
      "info": "t:sections.purelane_shared.settings.scene.info"
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "t:sections.purelane_shared.settings.anchor.label",
      "default": "signup",
      "info": "t:sections.purelane_shared.settings.anchor.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.purelane_signup.presets.name"
    }
  ]
}
{% endschema %}
