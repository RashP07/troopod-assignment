{%- comment -%}
  Purelane icon set.

  The prototype pasted the same five SVGs inline dozens of times — the leaf
  alone appeared 20+ times. One snippet keeps them consistent and keeps the
  rendered HTML small.

  Accepts:
    icon   - leaf | shield | no-chem | arrow | check | star (required)
    width  - stroke width, defaults per icon
    class  - extra class on the <svg>

  Every icon is decorative: it is always accompanied by text, so it is hidden
  from assistive tech rather than labelled.
{%- endcomment -%}

{%- liquid
  case icon
    when 'leaf'
      assign default_width = 1.6
    when 'shield'
      assign default_width = 1.6
    when 'no-chem'
      assign default_width = 1.6
    when 'arrow'
      assign default_width = 2.2
    when 'check'
      assign default_width = 2.4
    else
      assign default_width = 1.6
  endcase
  assign stroke_width = width | default: default_width
-%}

<svg
  class="{{ class }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="{{ stroke_width }}"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {%- case icon -%}
    {%- when 'leaf' -%}
      <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z" />
      <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z" />
    {%- when 'shield' -%}
      <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z" />
      <path d="m9 12 2.2 2.2L15.4 10" />
    {%- when 'no-chem' -%}
      <circle cx="12" cy="12" r="8.4" />
      <path d="M6.4 17.6 17.6 6.4" />
    {%- when 'arrow' -%}
      <path d="M5 12h13m-5-6 6 6-6 6" />
    {%- when 'check' -%}
      <path d="m5 13 4 4L19 7" />
  {%- endcase -%}
</svg>
